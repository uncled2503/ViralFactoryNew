# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://viralfactory.site).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-domain.example"

# Supabase Configurations
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# RoyPay API Configurations
ROYPAY_API_KEY="your-roypay-api-key"

# Enforces per-plan limits (videos/month, storage, projects, templates) server-side.
# The account mouragabriel2011@gmail.com is always unlimited regardless of this flag.
BILLING_ENABLED="true"

# --- Hardening & Security Configurations ---
# General API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Administrative API Rate Limiting
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=30

# WebSocket Protection (connections per IP limit)
WS_MAX_CONNECTIONS_PER_IP=10

# Shared secret the render-worker must present when registering over /ws/worker.
# Leave unset for trusted-network setups (e.g. docker-compose, worker on the same
# host). Required once a worker connects from a separate machine/over the public
# internet — must match WORKER_SECRET in the worker's own .env exactly.
WORKER_SECRET=""

# Rendering Job Timeout & Automated Failover/Re-queueing
JOB_TIMEOUT_MINUTES=10
JOB_TIMEOUT_MS=600000
JOB_MAX_ATTEMPTS=3

# Upload Constraints & Path Traversal Protections
MAX_UPLOAD_SIZE_BYTES=104857600
ALLOWED_UPLOAD_EXTENSIONS=".mp4,.mov,.png,.jpg,.jpeg,.gif,.webp,.json,.mp3,.wav,.aac"

# Redis Configurations (Pub/Sub, Progress Queue, Cache, Cluster Coordination)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=""


