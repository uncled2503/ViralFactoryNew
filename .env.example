# --- Hardening & Security Configurations ---
# General API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Administrative API Rate Limiting
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=30

# WebSocket Protection (connections per IP limit)
WS_MAX_CONNECTIONS_PER_IP=10

# Rendering Job Timeout & Automated Failover/Re-queueing
JOB_TIMEOUT_MINUTES=10
JOB_TIMEOUT_MS=600000
JOB_MAX_ATTEMPTS=3

# Upload Constraints & Path Traversal Protections
MAX_UPLOAD_SIZE_BYTES=104857600
ALLOWED_UPLOAD_EXTENSIONS=".mp4,.mov,.png,.jpg,.jpeg,.gif,.webp,.json,.mp3,.wav,.aac"

