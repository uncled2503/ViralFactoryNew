# Viral Factory Render Worker Configuration

# The HTTP URL of your SaaS Backend (used to download assets and upload final videos).
# Use http://localhost:3000 only if this worker runs on the SAME machine as the main
# server. If it runs on a separate machine, point it at your real public domain, e.g.:
# API_URL=https://viralfactory.site
API_URL=http://localhost:3000

# The WebSocket URL of your SaaS Backend (used for real-time control, progress, and
# heartbeats). Use wss:// (not ws://) once the main server is served over HTTPS —
# most reverse proxies reject a plain ws:// upgrade against an https:// origin.
# WS_URL=wss://viralfactory.site/ws/worker
WS_URL=ws://localhost:3000/ws/worker

# Must match WORKER_SECRET on the main server exactly once the worker connects from
# a separate machine/over the public internet (see the main server's .env.example).
# Leave blank for trusted same-host/docker-compose setups.
WORKER_SECRET=

# Optional: Unique identifier for this worker. If left blank, it will auto-generate one based on hostname.
# WORKER_ID=my-super-pc-worker

# Optional: Specific paths to FFmpeg/FFprobe binaries if they are not in your system PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
