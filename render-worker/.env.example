# Viral Factory Render Worker Configuration

# The HTTP URL of your SaaS Backend (used to download assets and upload final videos)
API_URL=http://localhost:3000

# The WebSocket URL of your SaaS Backend (used for real-time control, progress, and heartbeats)
WS_URL=ws://localhost:3000/ws/worker

# Optional: Unique identifier for this worker. If left blank, it will auto-generate one based on hostname.
# WORKER_ID=my-super-pc-worker

# Optional: Specific paths to FFmpeg/FFprobe binaries if they are not in your system PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
